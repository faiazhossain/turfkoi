# Turfkoi environment variables (SS58 + audit picks).
# Copy to .env and fill in. .env is gitignored; this file is the contract.

# ---- Public (safe to expose to the browser) ----
NEXT_PUBLIC_MAP_TILES_URL=        # Optional override; defaults to OpenFreeMap (free, keyless)
NEXT_PUBLIC_PUSHER_KEY=           # Pusher client key (audit G4)
NEXT_PUBLIC_PUSHER_CLUSTER=       # e.g. ap1
NEXT_PUBLIC_POSTHOG_KEY=          # PostHog public key (audit G6 - P1)
NEXT_PUBLIC_POSTHOG_HOST=         # e.g. https://us.i.posthog.com

# ---- Server-only: database + auth ----
DATABASE_URL=                     # Neon POOLED connection (app runtime)
DATABASE_DIRECT_URL=              # Neon DIRECT connection (migrations)
AUTH_SECRET=                      # generate: openssl rand -base64 32

# ---- Payment (server-only). MVP = bKash only (audit B6) ----
PAYMENT_BKASH_KEY=
PAYMENT_BKASH_SECRET=
# PAYMENT_NAGAD_KEY=              # Post-MVP
# PAYMENT_NAGAD_SECRET=           # Post-MVP

# ---- Image storage (Cloudinary). Images upload browser→Cloudinary with a
# server-signed grant; the API secret must never reach the client. ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public mirror of the cloud name for client-side delivery URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---- Realtime (Pusher, server-only) ----
PUSHER_APP_ID=
PUSHER_SECRET=

# ---- Rate limit + cache (Upstash Redis, audit G5) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Email OTP (Resend free tier, server-only) ----
RESEND_API_KEY=                  # unset = mock provider (dev). Required in prod.
OTP_EMAIL_FROM=                  # e.g. Turfkoi <noreply@turfkoi.com> (verified domain)

# ---- Background jobs (Inngest, audit G3) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Error tracking (Sentry) ----
SENTRY_DSN=

# ---- Push notifications [Post-MVP] ----
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

